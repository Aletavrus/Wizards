<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Game.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Game.Views"
		xmlns:local="clr-namespace:Game.Infrastructure"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Game.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Game">
        <views:MainView />
	<Window.Styles>
		<Style Selector="Button">
			<Setter Property="Height" Value="100"/>
			<Setter Property="Width" Value="100"/>
			<Setter Property="Command" Value="{Binding ButtonClick}"/>
			<Setter Property="CommandParameter">
				<local:MultiParameterMarkupExtension
                    Value1="{Binding RelativeSource={RelativeSource Self}, Path=Parent.Grid.Column}"
                    Value2="{Binding RelativeSource={RelativeSource Self}, Path=Parent.Grid.Row}" />
			</Setter>
		</Style>
	</Window.Styles>
</Window>